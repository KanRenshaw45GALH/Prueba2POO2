<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="520.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(#ffffff, #455A73);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador.CompartirElementoControlador">

    <children>

        <!-- Fondo del panel principal -->
        <Region layoutY="16.0" prefHeight="380.0" prefWidth="600.0" style="-fx-background-color: linear-gradient( #CF4910,#D55F24); -fx-background-radius: 30;" />

        <!-- Título -->
        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="-8.0" prefHeight="52.0" prefWidth="608.0" style="-fx-border-color: #ffffff; -fx-background-color: #ffffff;" text="COMPARTIR ELEMENTO" textAlignment="CENTER">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="28.0" />
            </font>
        </Label>

        <!-- Label: Seleccionar elemento -->
        <Label alignment="CENTER" layoutX="30.0" layoutY="75.0" prefHeight="40.0" prefWidth="197.0" style="-fx-border-color: #ffffff; -fx-border-radius: 60;" text="Elemento:" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="22.0" />
            </font>
        </Label>

        <!-- ComboBox de elementos del usuario -->
        <ComboBox fx:id="ComboBoxElementos" layoutX="240.0" layoutY="82.0" prefHeight="36.0" prefWidth="330.0" promptText="Selecciona un elemento" />

        <!-- Label: Nombre destino -->
        <Label alignment="CENTER" layoutX="30.0" layoutY="145.0" prefHeight="40.0" prefWidth="197.0" style="-fx-border-color: #ffffff; -fx-border-radius: 60;" text="Nombre destino:" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="22.0" />
            </font>
        </Label>

        <!-- TextField nombre destino -->
        <TextField fx:id="TextNombreDestino" layoutX="240.0" layoutY="152.0" prefHeight="36.0" prefWidth="330.0" promptText="Nombre completo del usuario" />


        <!-- Label de mensaje resultado -->
        <Label fx:id="lblMensaje" layoutX="30.0" layoutY="245.0" prefWidth="540.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true" />

        <!-- Botón Compartir -->
        <Button fx:id="BtnCompartir" alignment="CENTER" layoutX="60.0" layoutY="410.0" mnemonicParsing="false" onAction="#compartir" prefHeight="68.0" prefWidth="200.0" style="-fx-background-color: linear-gradient( #CF4910,#D57475); -fx-background-radius: 20;" text="COMPARTIR" textFill="WHITE">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="20.0" />
            </font>
        </Button>

        <!-- Botón Volver -->
        <Button fx:id="BtnVolver" alignment="CENTER" layoutX="340.0" layoutY="410.0" mnemonicParsing="false" onAction="#volver" prefHeight="68.0" prefWidth="200.0" style="-fx-background-color: linear-gradient(#0E7490, #0B2D5C); -fx-background-radius: 20;" text="VOLVER" textFill="WHITE">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="20.0" />
            </font>
        </Button>

    </children>
</Pane>
