<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controlador.registroUsarioControlador"
            stylesheets="@../resources/css/estilos.css"
            prefHeight="600.0" prefWidth="1100.0"
            styleClass="root">

    <HBox spacing="30" AnchorPane.topAnchor="40" AnchorPane.leftAnchor="40"
          AnchorPane.rightAnchor="40" AnchorPane.bottomAnchor="40">

        <!-- Card: Registrar Usuario -->
        <VBox styleClass="card" spacing="15" prefWidth="480" alignment="TOP_CENTER">
            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

            <Label text="Registrar Usuario" styleClass="titulo" alignment="CENTER" maxWidth="Infinity"/>

            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="180"/>
                    <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Usuario" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="tfUsuario" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Email" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="tfEmail" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Password" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="pfPassword" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Fecha de Nacimiento (DD/MM/AAAA)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="tfFechaNacimiento" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <Button text="Guardar" styleClass="btn-registrar" onAction="#guardarUsuario"
                    maxWidth="Infinity"/>

            <Label fx:id="lblMensajeRegistro" wrapText="true"/>
        </VBox>

        <!-- Card: Verificar Usuario -->
        <VBox styleClass="card" spacing="15" prefWidth="480" alignment="TOP_CENTER">
            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

            <Label text="Verificar Usuario" styleClass="titulo" alignment="CENTER" maxWidth="Infinity"/>

            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="100"/>
                    <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Usuario" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="tfUsuarioVerificar" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Password" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="pfPasswordVerificar" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <Button text="Verificar" styleClass="btn-registrar" onAction="#verificarUsuario"
                    maxWidth="Infinity"/>

            <Label fx:id="lblMensajeVerificar" wrapText="true"/>
        </VBox>

    </HBox>
</AnchorPane>