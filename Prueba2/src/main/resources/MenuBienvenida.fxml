<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="480.0" prefWidth="640.0" style="-fx-background-color: linear-gradient(#F27200,#F2C16C);" styleClass="root" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador.MenuBienvenidaControlador">

    <!-- Tarjeta centrada, igual que los formularios del compañero -->
    <VBox alignment="TOP_CENTER" prefWidth="420.0" spacing="0" styleClass="card" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="110.0" AnchorPane.rightAnchor="110.0" AnchorPane.topAnchor="60.0">

        <!-- Título superior igual al estilo "REGISTRAR USUARIO" -->
        <Label alignment="CENTER" maxWidth="Infinity" styleClass="titulo" text="GESTOR DE TAREAS">
            <VBox.margin>
                <Insets bottom="8.0" left="30.0" right="30.0" top="45.0" />
            </VBox.margin>
        </Label>

        <Label alignment="CENTER" maxWidth="Infinity" styleClass="titulo" text="Y RECORDATORIOS">
            <VBox.margin>
                <Insets bottom="40.0" left="30.0" right="30.0" />
            </VBox.margin>
        </Label>

        <!-- Subtítulo pequeño -->
        <Label alignment="CENTER" maxWidth="Infinity" styleClass="subtitulo-bienvenida" text="¿Qué deseas hacer?">
            <VBox.margin>
                <Insets bottom="35.0" />
            </VBox.margin>
        </Label>

        <!-- Spacer para empujar botones hacia abajo -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Botón Iniciar Sesión — franja azul igual a "Verificar" / "Guardar" -->
        <Button maxWidth="Infinity" onAction="#irAVerificar" prefHeight="52.0" styleClass="btn-bienvenida" text="INICIAR SESIÓN">
            <VBox.margin>
                <Insets bottom="16.0" left="30.0" right="30.0" />
            </VBox.margin>
        </Button>

        <!-- Botón Crear Cuenta — misma franja, segundo color -->
        <Button maxWidth="Infinity" onAction="#irARegistro" prefHeight="52.0" styleClass="btn-bienvenida-secundario" text="CREAR CUENTA">
            <VBox.margin>
                <Insets bottom="45.0" left="30.0" right="30.0" />
            </VBox.margin>
        </Button>

    </VBox>
</AnchorPane>
