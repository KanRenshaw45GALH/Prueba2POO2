<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="450.0" style="-fx-background-color: linear-gradient(#F27200,#F2C16C);" styleClass="root" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador.PagoBitcoinControlador">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label styleClass="titulo" text="Pagar con Bitcoin" />

                <VBox spacing="5.0" styleClass="card">
                    <padding>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </padding>
                    <children>
                        <Label styleClass="label-campo" text="Monto a Pagar" />
                        <Label fx:id="lblMonto" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="label-campo" text="Número de DUI" />
                        <TextField fx:id="txtDui" promptText="Ingresa tu DUI (ej: 00000000-0)" />
                    </children>
                </VBox>

                <Label fx:id="lblMensaje" styleClass="label-campo" wrapText="true" />

                <Button maxWidth="20000.0" mnemonicParsing="false" onAction="#pagar" styleClass="btn-registrar" text="Confirmar Pago" />
                <Button maxWidth="20000.0" mnemonicParsing="false" onAction="#cancelar" style="-fx-background-color: #777;" styleClass="btn-registrar" text="Cancelar" />
            </children>
        </VBox>
    </children>
</AnchorPane>
